<%- include("partials/header", { title }) %>
<%- include("partials/nav") %>
<main class="container">
  <h1>Watch History</h1>
  <p class="muted"><%= user ? user.name + ' (' + user.email + ')' : 'User not found' %></p>

  <section class="card">
    <table>
      <thead>
        <tr>
          <th>Movie</th>
          <th>Viewed At</th>
        </tr>
      </thead>
      <tbody>
        <% history.forEach((entry) => { %>
          <tr>
            <td><%= entry.movie ? entry.movie.title : 'Deleted movie' %></td>
            <td><%= new Date(entry.viewedAt).toLocaleString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
</main>
<%- include("partials/footer") %>
